{
  "name": "ncamart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "start:worker": "tsx src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:int": "vitest run --project=integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.cjs",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "search:reindex": "tsx src/modules/search/reindex.ts",
    "openapi:generate": "tsx src/lib/openapi.ts && tsx scripts/generate-postman.ts",
    "openapi:check": "tsx src/lib/openapi/check.ts",
    "postman:generate": "tsx scripts/generate-postman.ts",
    "staff:create-admin": "node scripts/create-admin.cjs",
    "git:pull": "node scripts/git-pull.cjs",
    "dev:scenario": "tsx src/db/scenarios/runner.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@sentry/nextjs": "^9.5.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.7",
    "drizzle-orm": "^0.40.0",
    "ioredis": "^5.6.0",
    "meilisearch": "^0.62.0",
    "next": "15.2.1",
    "otplib": "^13.5.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@testcontainers/postgresql": "^10.18.0",
    "@testcontainers/redis": "^10.18.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
