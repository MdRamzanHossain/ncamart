# Node & Environment
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgres://ncamart:ncamart_dev_pwd@localhost:5432/ncamart_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis 7
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ncamart_meili_master_key_local_dev

# Cloudflare R2 / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=ncamart-media
S3_BUCKET_PRIVATE=ncamart-private
S3_BUCKET_AUDIT=ncamart-audit
S3_PUBLIC_DOMAIN=http://localhost:9000/ncamart-media

# Security & Encryption Secrets
# AES-256-GCM key (32 bytes / 64 hex chars) for TOTP secrets at rest
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=super-secret-session-token-ncamart-local-development-key

# External Services: Mock Flags (true for local development with zero credentials)
MOCK_EXTERNAL_SERVICES=true

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=ncama_sandbox
SSLCOMMERZ_STORE_PASS=ncama_sandbox@ssl
SSLCOMMERZ_IS_SANDBOX=true

# Couriers (Steadfast, Pathao, RedX)
STEADFAST_API_KEY=mock_steadfast_api_key
STEADFAST_SECRET_KEY=mock_steadfast_secret
PATHAO_CLIENT_ID=mock_pathao_client_id
PATHAO_CLIENT_SECRET=mock_pathao_secret
PATHAO_USERNAME=mock_pathao_user
PATHAO_PASSWORD=mock_pathao_pwd
REDX_ACCESS_TOKEN=mock_redx_token

# Communications: SMS, WhatsApp, Email
SMS_PROVIDER=mock
SMS_API_KEY=mock_sms_api_key
SMS_SENDER_ID=NCAMart
WHATSAPP_API_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_wa_phone_id
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NCAMart <noreply@ncamart.com>"

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Observability & Analytics
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
